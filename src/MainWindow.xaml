<Window x:Class="Aion2Trainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        Title="AION 2 Combat Trainer"
        Height="450"
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#cccccc">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="AION 2 Combat Trainer"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#007acc"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <CheckBox x:Name="chkGodMode" Content="God Mode" Margin="0,0,0,8" Foreground="#cccccc"/>
            <CheckBox x:Name="chkInfiniteHP" Content="Infinite HP" Margin="0,0,0,8" Foreground="#cccccc"/>
            <CheckBox x:Name="chkInfiniteMP" Content="Infinite MP" Margin="0,0,0,8" Foreground="#cccccc"/>
            <CheckBox x:Name="chkOneHitKill" Content="One Hit Kill" Margin="0,0,0,8" Foreground="#cccccc"/>
            <CheckBox x:Name="chkInfiniteKinah" Content="Infinite Kinah" Margin="0,0,0,8" Foreground="#cccccc"/>
            <CheckBox x:Name="chkNoCooldown" Content="No Cooldown" Margin="0,0,0,8" Foreground="#cccccc"/>
            <CheckBox x:Name="chkSuperSpeed" Content="Super Speed" Margin="0,0,0,16" Foreground="#cccccc"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Damage Multiplier:" VerticalAlignment="Center" Foreground="#cccccc" Margin="0,0,8,0"/>
                <TextBox x:Name="txtDamageMultiplier" Width="80" Text="1.0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnApply" Content="Apply" Width="100" Height="32" Margin="0,0,10,0"
                        Background="#007acc" Foreground="White" BorderThickness="0" Click="BtnApply_Click"/>
                <Button x:Name="btnReset" Content="Reset" Width="100" Height="32"
                        Background="#333333" Foreground="White" BorderThickness="0" Click="BtnReset_Click"/>
            </StackPanel>
        </StackPanel>

        <StatusBar Grid.Row="2" Margin="0,20,0,0" Background="#2d2d2d" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Foreground="#888888" Text="Not connected to game process"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>